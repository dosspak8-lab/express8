                <label>Username:</label>
                <input class="px-4 py-2 border border-violet-700  mb-4 rounded-x1" name="username">
                <label>Password:</label>
                <input type="password" class="px-4 py-2 border border-violet-700 mb-4 rounded-x1" name="password">

                <button class="bg-violet-400 rounded-2xl p-1 text-white">Login</button>
            </form>
        </div>
    </div>
