<body>
<body class="p-5">
    <div class="w-full h-screen bg-indigo-800  flex items-center justify-center ">
        <div class="w-[50%] bg-gray-300 border-purple-600 shadow-[0_0_30px_#730AA3] p-8 rounded-lg">
            <h1 class="text 2xl: mb-4 font-bold drop ">LOGIN</h1>
